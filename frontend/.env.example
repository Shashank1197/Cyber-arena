# Frontend build-time env vars (Vercel / any host)

# Base URL of the backend WebSocket + REST service, WITHOUT a trailing slash.
# For split-host deploys (frontend on Vercel, backend elsewhere):
#   VITE_API_URL=https://your-backend.onrender.com
# For same-origin (docker-compose/nginx) deploys, leave this empty.
VITE_API_URL=
