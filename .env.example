# Copy to .env and adjust. Backend loads this file from the backend/ directory.

# FastAPI server binding
HOST=0.0.0.0
PORT=8000

# Comma-separated allowed origins for the browser UI (dev uses Vite)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# MongoDB connection string. Leave empty to run with in-memory persistence.
MONGO_URL=mongodb://localhost:27017
MONGO_DB=cyber_arena

# Set true for verbose logging
DEBUG=false
